# PostgreSQL 접속 정보 (docker-compose 사용 시 DATABASE_URL은 compose가 db 서비스로 덮어쓴다.
# 로컬에서 uvicorn을 직접 띄워 테스트할 때만 이 값이 실제로 쓰인다.)
DATABASE_URL=postgresql://moneylogic:password@localhost:5432/moneylogic
POSTGRES_PASSWORD=change_me

# Google Gemini (대본 생성)
GEMINI_API_KEY=your_gemini_api_key

# Pexels (배경 이미지 검색)
PEXELS_API_KEY=your_pexels_api_key

# 크리티컬 에러 알림용 디스코드 웹훅 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
