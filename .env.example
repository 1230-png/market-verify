# ===========================================================================
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.   copy .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# ===========================================================================

# --- Phase 1: 대본 생성 --------------------------------------------------
# openai | gemini | none   (none = API 없이 규칙 기반 대본, 동작 확인용)
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 크롤링할 RSS 피드 (콤마 구분). 원하는 매체로 바꾸세요.
FEED_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://kr.investing.com/rss/news_301.rss
MAX_HEADLINES=8

# --- 주제 중복 방지 (assets/history.json) ---
# 최근 며칠 안에 다룬 주제를 제외할지. 기본 90일 = 3개월
HISTORY_DAYS=90
# 제목 키워드가 이 비율 이상 겹치면 같은 사건으로 본다 (0~1). 낮출수록 엄격
HISTORY_SIMILARITY=0.6
# history.json 보존 기간
HISTORY_RETENTION_DAYS=365

# 대본 목표 길이(자)와 영상 최대 길이(초). 쇼츠는 60초 미만이어야 합니다.
TARGET_CHARS=300
MAX_VIDEO_SECONDS=58

# --- Phase 2: TTS --------------------------------------------------------
# 한국어 남성 음성. `python tts_generator.py --list-voices` 로 목록 확인 가능.
TTS_VOICE=ko-KR-InJoonNeural
TTS_RATE=+8%
TTS_VOLUME=+0%

# --- Phase 3: 영상 -------------------------------------------------------
# https://www.pexels.com/api/ 에서 무료 발급
PEXELS_API_KEY=
PEXELS_QUERY=bitcoin
PEXELS_CLIP_COUNT=3

VIDEO_W=1080
VIDEO_H=1920
VIDEO_FPS=30
SUBTITLE_FONT_SIZE=62
SUBTITLE_BOTTOM_MARGIN=320
# 자막 폰트를 직접 지정하고 싶을 때 (기본값은 Windows 맑은 고딕 자동 탐색)
# SUBTITLE_FONT=C:\Windows\Fonts\malgun.ttf

# --- Phase 4: 유튜브 업로드 ----------------------------------------------
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=25
YOUTUBE_TAGS=비트코인,암호화폐,코인뉴스,shorts
# 설명란 맨 끝에 붙는 면책 조항. 빈 값으로 두면 붙지 않습니다.
YOUTUBE_DISCLAIMER=[본 영상은 개인의 주관적인 차트 분석이며, 투자 권유나 리딩이 아닙니다. 모든 투자의 책임은 본인에게 있습니다.]

# --- 주간 자동 실행 스케줄러 (scheduler.py) ---
API_BASE_URL=http://127.0.0.1:8000
# 실행 요일: monday ~ sunday
SCHEDULE_DAY=sunday
# 실행 시각 HH:MM (24시간)
SCHEDULE_TIME=20:00
